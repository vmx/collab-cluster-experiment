[Unit]
Description=collab-cluster node (BT 6881 / HTTP 8001, multicast beacon on 6772)

[Service]
# A node needs no configuration at all: it finds its peers on the local network,
# and nothing — not even the optional dashboard — has to be pointed at it.
WorkingDirectory=%h/collab-cluster-experiment
ExecStart=python3 node.py
Restart=on-failure

[Install]
WantedBy=default.target
