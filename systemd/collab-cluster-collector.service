[Unit]
Description=collab-cluster dashboard (optional stats collector + web UI, port 8100)

[Service]
# Needs no configuration: it binds all interfaces and waits for nodes to push.
# Nothing in the swarm depends on it — it is purely a view.
WorkingDirectory=%h/collab-cluster-experiment
ExecStart=python3 collector.py
Restart=on-failure

[Install]
WantedBy=default.target
