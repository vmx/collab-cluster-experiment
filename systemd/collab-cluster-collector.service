[Unit]
Description=collab-cluster dashboard (optional stats collector + web UI, port 8100)

[Service]
# Reads the swarm through one node, defaulting to a node on this machine. If
# the dashboard runs somewhere without one, append any node's address:
#   ExecStart=python3 collector.py node0.example:8001
# Nothing in the swarm depends on it, or knows it exists — it is purely a view.
WorkingDirectory=%h/collab-cluster-experiment
ExecStart=python3 collector.py
Restart=on-failure

[Install]
WantedBy=default.target
